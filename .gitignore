# The Secret Box (Your API keys and paths)
.env

# The Tool Box (Your installed libraries)
.venv/
env/
venv/

# Google Cloud Key (The actual JSON file itself)
*.json
!vercel.json
!my-dashboard/package.json
!my-dashboard/package-lock.json
!my-dashboard/public/*.json

# Python cache (Speeds up execution, but messy to share)
__pycache__/
*.pyc
# Small demo inventory for USE_SAMPLE_DATA=1
!sample_inventory.json

# Local only: design mockups, the Impeccable design tool, and the member roster (personal data).
mockups/
.claude/
.impeccable/
members.local.json
