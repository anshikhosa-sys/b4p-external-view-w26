# Copy to .env for local development. Never commit real values.

# Google Sheets
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEET_ID=
REQUESTS_WORKSHEET_TITLE=
ORG_REQUESTS_WORKSHEET_TITLE=

# Postgres (unset = use the sheet)
DATABASE_URL=

# HQ-only endpoints
HQ_API_TOKEN=

# --- Email (see docs/EMAIL.md) ---
# Pick ONE provider. First match wins: Resend, then Brevo, then Gmail SMTP.
RESEND_API_KEY=
BREVO_API_KEY=
# Gmail SMTP works locally only; Render blocks it.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sender, e.g. Blueprints for Pangaea <requests@example.org>
# Must be a verified sender/domain in Resend or Brevo.
EMAIL_FROM=
# Receives new-request alerts. Unset = no alerts. Also the default Reply-To.
HQ_EMAIL=
# Optional Reply-To override
EMAIL_REPLY_TO=
# Set to false to stop confirmation and HQ emails on submit (status emails still send)
EMAIL_ON_SUBMIT=true
# Max emails per rolling 24h (default 200)
EMAIL_DAILY_LIMIT=

# Rate limit by the real client IP from X-Forwarded-For. Set automatically on Render (RENDER is set).
# 1 = force on elsewhere behind one proxy, 0 = force off. Leave blank otherwise.
TRUST_PROXY=
SAMPLE_INVENTORY_PATH=
